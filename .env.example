# =====================================================
# CashZilla — Environment Configuration
# =====================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git/github.
# =====================================================

# --- Telegram Bot ---
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_USERNAME=YourBotName_bot

# --- Domain ---
DOMAIN=https://yourdomain.com
ADMIN_DOMAIN=https://admin.yourdomain.com

# --- MySQL Database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=cashzilla

# --- Admin Login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_TOKEN=CHANGE_THIS_SECRET_TOKEN

# --- Server Ports ---
USER_PORT=3000
ADMIN_PORT=3001
